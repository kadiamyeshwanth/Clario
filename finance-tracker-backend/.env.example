# ── Required ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/clario
# At least 32 random characters in production:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-48-plus-characters

# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Public URLs (no trailing slash). BACKEND_URL is baked into SMS webhook URLs.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
# Extra allowed browser origins, comma-separated (FRONTEND_URL is always allowed).
CORS_ORIGIN=
# Deep-link scheme of the mobile app (Google sign-in returns here).
MOBILE_SCHEME=clario

# ── Sessions ────────────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# ── Optional features ───────────────────────────────────────────────────────
# Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Password-reset email: Brevo HTTP API (works on hosts that block SMTP) …
BREVO_API_KEY=
# … or SMTP. EMAIL_USER is also the "from" address for Brevo.
EMAIL_USER=
EMAIL_PASS=
# Exchange rates (keyless provider by default). FX_DISABLED=true uses a built-in table.
FX_API_URL=https://open.er-api.com/v6/latest
FX_DISABLED=false
# Expo push notifications for the mobile app
PUSH_DISABLED=false
# Scheduled jobs (recurring, streaks, alerts). Turn off on all but one instance.
RUN_CRON=true
LOG_LEVEL=info
